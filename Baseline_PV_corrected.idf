    Generator:Photovoltaic,  !- Generator 1 Object Type
    1518,                    !- Generator 1 Rated Electric Power Output {W}
    ,                        !- Generator 1 Availability Schedule Name
    ,                        !- Generator 1 Rated Thermal to Electrical Power Ratio
    PV2,                     !- Generator 2 Name
    Generator:Photovoltaic,  !- Generator 2 Object Type
    2708,                    !- Generator 2 Rated Electric Power Output {W}
    ,                        !- Generator 2 Availability Schedule Name
    ,                        !- Generator 2 Rated Thermal to Electrical Power Ratio
    PV3,                     !- Generator 3 Name
    Generator:Photovoltaic,  !- Generator 3 Object Type
    1617,                    !- Generator 3 Rated Electric Power Output {W}
    ,                        !- Generator 3 Availability Schedule Name
    ,                        !- Generator 3 Rated Thermal to Electrical Power Ratio
    PV4,                     !- Generator 4 Name
    Generator:Photovoltaic,  !- Generator 4 Object Type
    135,                     !- Generator 4 Rated Electric Power Output {W}
    ,                        !- Generator 4 Availability Schedule Name
    ,                        !- Generator 4 Rated Thermal to Electrical Power Ratio
    PV5,                     !- Generator 5 Name
    Generator:Photovoltaic,  !- Generator 5 Object Type
