!-   ===========  ALL OBJECTS IN CLASS: ELECTRICLOADCENTER:DISTRIBUTION ===========

ElectricLoadCenter:Distribution,
    Main_PV_Distribution,    !- Name
    RoofPV_Generators,       !- Generator List Name
    Baseload,                !- Generator Operation Scheme Type
    ,                        !- Generator Demand Limit Scheme Purchased Electric Demand Limit {W}
    ,                        !- Generator Track Schedule Name Scheme Schedule Name
    ,                        !- Generator Track Meter Scheme Meter Name
    DirectCurrentWithInverter,  !- Electrical Buss Type
    PV_Inverter,             !- Inverter Name
    ,                        !- Electrical Storage Object Name
    ,                        !- Transformer Object Name
    ,                        !- Storage Operation Scheme
    ,                        !- Storage Control Track Meter Name
    ,                        !- Storage Converter Object Name
    1;                       !- Maximum Storage State of Charge Fraction


!-   ===========  ALL OBJECTS IN CLASS: PHOTOVOLTAICPERFORMANCE:SIMPLE ===========

! Added: the Generator:Photovoltaic objects referenced this type but no performance object existed.
! 85% of each roof surface covered with cells, fixed 18% cell efficiency (typical mono-Si module).
PhotovoltaicPerformance:Simple,
    PV_Simple_Perf,          !- Name
    0.85,                    !- Fraction of Surface Area with Active Solar Cells {dimensionless}
    Fixed,                   !- Conversion Efficiency Input Mode
    0.18;                    !- Value for Cell Efficiency if Fixed


!-   ===========  ALL OBJECTS IN CLASS: ELECTRICLOADCENTER:INVERTER:SIMPLE ===========

! Added: PV produces DC, so the load center needs an inverter (96% efficient, mounted outdoors).
ElectricLoadCenter:Inverter:Simple,
    PV_Inverter,             !- Name
    ,                        !- Availability Schedule Name
    ,                        !- Zone Name
    0,                       !- Radiative Fraction
    0.96;                    !- Inverter Efficiency


