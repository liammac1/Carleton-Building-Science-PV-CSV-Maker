!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER ===========

EnergyManagementSystem:ProgramCallingManager,
    Doorway_Mixing_Manager,  !- Name
    BeginTimestepBeforePredictor,  !- EnergyPlus Model Calling Point
    Doorway_Mixing_ASHRAE;   !- Program Name 1


!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAM ===========

EnergyManagementSystem:Program,
    Doorway_Mixing_ASHRAE,   !- Name
    SET g = 9.81,            !- Program Line 1
    SET W_Bed = 0.8130,      !- Program Line 2
    SET H_Bed = 2.0320,      !- A4
    SET D_Bed = T_Living_6 - T_Bedroom_5,  !- A5
    SET dT_Bed = @Abs D_Bed, !- A6
    SET Tw_Bed = @Max T_Living_6 T_Bedroom_5,  !- A7
    SET Tw_Bed = Tw_Bed + 273.15,  !- A8
    SET Cd_Bed = 0.40 + 0.0045 * dT_Bed,  !- A9
    SET A_Bed = W_Bed * H_Bed / 2,  !- A10
    SET dH_Bed = H_Bed / 4,  !- A11
    SET X_Bed = 2 * g * dH_Bed * dT_Bed / Tw_Bed,  !- A12
    SET V_Bed = X_Bed ^ 0.5, !- A13
    SET Q_Bed = Cd_Bed * A_Bed * V_Bed,  !- A14
    SET Q_Bedroom_5_to_Living_6 = Q_Bed,  !- A15
    SET Q_Living_6_to_Bedroom_5 = Q_Bed,  !- A16
    SET W_Wash = 0.8130,     !- A17
    SET H_Wash = 2.0320,     !- A18
    SET D_Wash = T_Living_6 - T_Washroom_7,  !- A19
    SET dT_Wash = @Abs D_Wash,  !- A20
    SET Tw_Wash = @Max T_Living_6 T_Washroom_7,  !- A21
    SET Tw_Wash = Tw_Wash + 273.15,  !- A22
    SET Cd_Wash = 0.40 + 0.0045 * dT_Wash,  !- A23
    SET A_Wash = W_Wash * H_Wash / 2,  !- A24
    SET dH_Wash = H_Wash / 4,!- A25
    SET X_Wash = 2 * g * dH_Wash * dT_Wash / Tw_Wash,  !- A26
    SET V_Wash = X_Wash ^ 0.5,  !- A27
    SET Q_Wash = Cd_Wash * A_Wash * V_Wash,  !- A28
    SET Q_Washroom_7_to_Living_6 = Q_Wash,  !- A29
    SET Q_Living_6_to_Washroom_7 = Q_Wash,  !- A30
    SET W_WD = 0.7618,       !- A31
    SET H_WD = 2.0320,       !- A32
    SET D_WD = T_Living_6 - T_W_D_5,  !- A33
    SET dT_WD = @Abs D_WD,   !- A34
    SET Tw_WD = @Max T_Living_6 T_W_D_5,  !- A35
    SET Tw_WD = Tw_WD + 273.15,  !- A36
    SET Cd_WD = 0.40 + 0.0045 * dT_WD,  !- A37
    SET A_WD = W_WD * H_WD / 2,  !- A38
    SET dH_WD = H_WD / 4,    !- A39
    SET X_WD = 2 * g * dH_WD * dT_WD / Tw_WD,  !- A40
    SET V_WD = X_WD ^ 0.5,   !- A41
    SET Q_WD = Cd_WD * A_WD * V_WD,  !- A42
    SET Q_W_D_5_to_Living_6 = Q_WD,  !- A43
    SET Q_Living_6_to_W_D_5 = Q_WD,  !- A44
    SET W_Vest = 0.8130,     !- A45
    SET H_Vest = 2.0320,     !- A46
    SET D_Vest = T_Living_6 - T_Vestibule_and_Stairs,  !- A47
    SET dT_Vest = @Abs D_Vest,  !- A48
    SET Tw_Vest = @Max T_Living_6 T_Vestibule_and_Stairs,  !- A49
    SET Tw_Vest = Tw_Vest + 273.15,  !- A50
    SET Cd_Vest = 0.40 + 0.0045 * dT_Vest,  !- A51
    SET A_Vest = W_Vest * H_Vest / 2,  !- A52
    SET dH_Vest = H_Vest / 4,!- A53
    SET X_Vest = 2 * g * dH_Vest * dT_Vest / Tw_Vest,  !- A54
    SET V_Vest = X_Vest ^ 0.5,  !- A55
    SET Q_Vest = Cd_Vest * A_Vest * V_Vest,  !- A56
    SET Q_Vestibule_and_Stairs_to_Living_6 = Q_Vest,  !- A57
    SET Q_Living_6_to_Vestibule_and_Stairs = Q_Vest;  !- A58


